# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
T2S_LLM_BASE_URL=https://api.deepseek.com/v1
T2S_LLM_API_KEY=sk-xxxxxxxx
T2S_LLM_MODEL=deepseek-chat
T2S_LLM_TIMEOUT_S=60
T2S_LLM_TEMPERATURE=0.2
T2S_DB_PATH=db/securities.db
T2S_MEMORY_DB_PATH=db/memory.db
T2S_SQL_TIMEOUT_S=30
T2S_SQL_ROW_LIMIT=100

# 语义记忆（M4，可选）：配置后样例库/口径库走向量检索，否则降级关键词
# 需供应商支持 OpenAI 兼容 /embeddings（如 Qwen/GLM/SiliconFlow）
T2S_EMBEDDING_MODEL=
T2S_EMBEDDING_BASE_URL=
T2S_EMBEDDING_API_KEY=
