      "dot": "emerald",
      "title": "三层职责",
      "items": [
        "路由：意图分类 · 权限初检 · 会话串行",
        "管理层零 LLM：可单测的确定性治理",
        "执行层：LLM 只在这里；二期快路径 = 强制计划模式"
      ]
    },
    {
      "dot": "cyan",
      "title": "工具五件套",
      "items": [
        "search_schema / get_schema：向量召回 + 完整 DDL",
        "validate_sql：sqlglot 白盒校验（补齐 DB-GPT 缺环）",
        "execute_sql：只读账号 · 强制 LIMIT · 超时",
        "ask_user：口径歧义澄清，每 turn ≤ 2 次"
      ]
    },
    {
      "dot": "rose",
      "title": "护栏与审计",
      "items": [
        "四层防护：步数≤12 · 打转检测 · 错误回喂≤2 · 墙钟 300s",
        "失败降级：转人工 / 提工单（一期留桩）",
        "审计：谁 · 何时 · 问了什么 · 执行 SQL · 返回行数"
      ]
    }
